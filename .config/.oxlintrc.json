{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["docs/**"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "node",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-expressions": "off", // logtape で使用します。
    "no-unused-vars": "warn", // 早すぎる最適化です。
    "vitest/no-focused-tests": "off" // デバッグ作業を容易にします。
  },
  "env": {
    "builtin": true
  },
  "options": {
    "typeAware": true
  }
}
